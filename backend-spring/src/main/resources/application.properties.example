# 이 파일을 application.properties 로 복사해서 사용합니다.
# 기본값은 docker-compose.yml 의 DB 설정과 같아 별도 설정 없이 실행됩니다.
spring.application.name=backend-spring

server.port=${SERVER_PORT:8081}
server.servlet.context-path=/bingo

spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/bingo?allowPublicKeyRetrieval=true&useSSL=false&nullCatalogMeansCurrent=true}
spring.datasource.username=${DB_USERNAME:bingo}
spring.datasource.password=${DB_PASSWORD:ecolink_local}

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.database-platform=org.hibernate.dialect.MariaDBDialect

ai.server.url=${AI_SERVER_URL:http://localhost:8000}

# 카카오 키가 없어도 서버는 실행되며, 지도 · 경로 안내 기능만 동작하지 않습니다.
kakao.map.key=${KAKAO_MAP_KEY:}
kakao.rest.api.key=${KAKAO_REST_API_KEY:}
